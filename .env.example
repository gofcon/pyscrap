ORACLE_USER=your_user
ORACLE_PASSWORD=your_password
ORACLE_DSN=(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1521)(host=adb.your-region.oraclecloud.com))(connect_data=(service_name=your_service_high.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))

# Optional: mTLS wallet connection (see app/db_config.py, app/db/engine.py)
# -- independent of the client's source IP, unlike the plain-TLS + ACL
# connection above. If set, ORACLE_DSN should instead be a TNS alias from
# the wallet's tnsnames.ora (e.g. "yourdb_medium"). Never commit an actual
# wallet directory -- see .gitignore.
# ORACLE_WALLET_DIR=wallet
# ORACLE_WALLET_PASSWORD=your_wallet_password

LOG_LEVEL=INFO

# per-site scraper secrets, referenced from api_mst.header_json/payload_json/
# api_url as "${VAR_NAME}" -- resolved at request-build time, see app/auth_config.py
KRX_AUTH_KEY=your_krx_open_api_key
DART_KEY=your_dart_open_api_key

# KIS Open API (Korea Investment & Securities) -- KIS_ACCESS_TOKEN is issued
# and refreshed automatically by the KIS_TOKEN_REFRESH job (see
# app/db/models.py ApiMst.persist_env_json); the placeholder value here is
# just so the app doesn't error before that job's first run.
KIS_PROD=https://openapi.koreainvestment.com:9443
KIS_APP_KEY=your_kis_app_key
KIS_APP_SECRET=your_kis_app_secret
KIS_ACCESS_TOKEN=

# OCI Object Storage (S3-compatible API), for Parquet exports -- see
# app/object_storage.py and app/services/export.py
OCI_REGION=your_region
OCI_NAMESPACE=your_namespace
OCI_BUCKET_NAME=your_bucket_name
OCI_ACCESS_KEY=your_access_key
OCI_SECRET_KEY=your_secret_key

# Optional: local staging directory for buffered CSV exports before they're
# finalized to Parquet (see app/services/export.py). Defaults to
# "data/exports" (relative to the working directory) if unset.
# EXPORT_DATA_DIR=data/exports

# Optional: local log file directory (see app/logging_config.py) -- rotates
# daily, keeps 30 days, compressed. Defaults to "data/logs" if unset.
# LOG_DIR=data/logs

# Optional: seconds to sleep between page fetches when a paginated API is
# scraped (see app/scrapers/dynamic.py fetch_all_pages). Defaults to 0.3 if unset.
# PAGE_DELAY_SEC=0.3
