# =========================================================================
# pyscrap v3 Environment Configuration Template
# Copy to .env and chmod 600 .env (NEVER commit real secrets to Git).
# =========================================================================

# 1. Neon DB (Control Plane — Pooled "-pooler" connection string recommended)
NEON_DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# 2. Primary S3 Bucket: OCI Object Storage (20GB Always Free, canonical store)
#    v3 writes strictly under V3_BUCKET_PREFIX (default: v3/).
V3_BUCKET_PREFIX=v3
S3_OCI_ENDPOINT_URL=https://your_namespace.compat.objectstorage.ap-chuncheon-1.oraclecloud.com
S3_OCI_REGION=ap-chuncheon-1
S3_OCI_BUCKET=your_bucket_name
S3_OCI_ACCESS_KEY=your_access_key
S3_OCI_SECRET_KEY=your_secret_key

# Legacy OCI_* fallback (optional; used automatically if S3_OCI_* is unset)
# OCI_NAMESPACE=your_namespace
# OCI_REGION=ap-chuncheon-1
# OCI_BUCKET_NAME=your_bucket_name
# OCI_ACCESS_KEY=your_access_key
# OCI_SECRET_KEY=your_secret_key

# 3. Optional 2nd-tier S3 Bucket: Cloudflare R2 (10GB Free, $0 egress for Web UI)
#    Leave unset in Phase 1; unconfigured targets are skipped automatically.
# S3_R2_ENDPOINT_URL=https://your_account_id.r2.cloudflarestorage.com
# S3_R2_REGION=auto
# S3_R2_BUCKET=your_r2_bucket
# S3_R2_ACCESS_KEY=your_r2_access_key
# S3_R2_SECRET_KEY=your_r2_secret_key

# 4. Per-site Scraper Credentials (referenced via ${VAR} in api_mst.spec_json)
KRX_AUTH_KEY=your_krx_open_api_key
KRX_DATA_ID=your_krx_data_id
KRX_DATA_PW=your_krx_data_pw
DART_KEY=your_dart_open_api_key

KIS_PROD=https://openapi.koreainvestment.com:9443
KIS_APP_KEY=your_kis_app_key
KIS_APP_SECRET=your_kis_app_secret
KIS_APP_KEY_2=your_second_kis_app_key
KIS_APP_SECRET_2=your_second_kis_app_secret
# Note: KIS_ACCESS_TOKEN / KIS_ACCESS_TOKEN_2 are managed automatically in
# data/cache/session_store.json by KIS_TOKEN_REFRESH (no .env mutation).

# 5. FastAPI Admin Auth & Runtime Paths (OCI ARM A1 / Micro safe defaults)
# ADMIN_API_KEY=change_me_in_production
# API_DUCKDB_CONCURRENCY=2
# PAGE_DELAY_SEC=0.3
# V3_TMP_DIR=data/tmp
# V3_DUCKDB_TMP_DIR=data/tmp/duckdb
# V3_CACHE_DIR=data/cache
# V3_LEDGER_DIR=data/logs/ledger
# V3_SESSION_STORE_PATH=data/cache/session_store.json
# BROWSER_STATE_DIR=data/state
# BROWSER_HEADLESS=1

# 6. One-off Oracle v2 Migration ONLY (scripts/migrate_v2_to_v3.py)
# ORACLE_USER=
# ORACLE_PASSWORD=
# ORACLE_DSN=
# ORACLE_WALLET_DIR=
# ORACLE_WALLET_PASSWORD=
