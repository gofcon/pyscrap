[Unit]
Description=Timer for Main Scraper Daily-End Execution

[Timer]
# Run at 18:00 -- after market close, for jobs that need the
# day's data fully settled (e.g. DART filings, KRX EOD prices).
# Mon..Fri only -- same "weekday, no public-holiday calendar" scope as
# app.services.job_builder._last_bday, so Lunar New Year/Chuseok etc. still fire.
OnCalendar=Mon..Fri *-*-* 18:00:00
Persistent=true

[Install]
WantedBy=timers.target
