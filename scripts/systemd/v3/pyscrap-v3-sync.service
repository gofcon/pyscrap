[Unit]
Description=pyscrap v3 Pre-Market Neon Config Snapshot & Manual Parquet Mirror
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=opc
Group=opc
WorkingDirectory=/home/opc/pyscrap
ExecStart=/bin/bash /home/opc/pyscrap/scripts/systemd/v3/run_v3.sh sync
MemoryHigh=400M
MemoryMax=600M

[Install]
WantedBy=multi-user.target
