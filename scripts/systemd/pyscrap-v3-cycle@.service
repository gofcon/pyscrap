[Unit]
Description=pyscrap v3 Regular HTTP Cycle (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=opc
Group=opc
WorkingDirectory=/home/opc/pyscrap
ExecStart=/bin/bash /home/opc/pyscrap/scripts/systemd/run_v3.sh cycle %i
MemoryHigh=700M
MemoryMax=900M

[Install]
WantedBy=multi-user.target
