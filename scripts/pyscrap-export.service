[Unit]
Description=pyscrap Export to Object Storage (18:10, after the day's collection)
After=network.target pyscrap-daily-end.service

[Service]
Type=oneshot
User=opc
Group=opc
WorkingDirectory=/home/opc/pyscrap
# 지수 시계열 갱신(stock_index_his, 그 끝의 v_k2i_atm)은 sp_run_export 의 첫
# 단계다(scripts/sql/sp_run_export.sql). 그 갱신 전에 내보내면 당일분이 빈 채로
# 나가고 파일은 만들어지므로 배치는 성공으로 끝난다 -- 순서가 실제 의존이라
# 예전엔 이 유닛이 두 명령을 차례로 불러 지켰고, 지금은 그 순서가 SQL 에 있다.
# 어느 단계가 실패하면 그 자리에서 멈춘다. 다시 돌리면 되고, sp_export_parquet
# 은 같은 날짜를 몇 번 내보내도 결과가 같다.
ExecStart=/bin/bash /home/opc/pyscrap/scripts/run_command.sh run-export

[Install]
WantedBy=multi-user.target
