[Unit]
Description=Timer for pyscrap Monthly Archive

[Timer]
# 매월 1일 23:30 -- check-sql(23:00) 뒤, 그날 배치가 전부 끝난 시각.
# 요일 제한이 없다: 하는 일이 DB 안에서 끝나므로 장이 서는 날일 필요가 없고,
# 1일이 주말이면 그 주 금요일까지의 수집분이 그대로 대상이다.
#
# 주기가 한 달인 이유는 --keep-days 31 과 짝이라서다. 더 자주 돌면 매번 지울
# 것이 거의 없고, 실행마다 _arch 폴더가 하나씩 늘어난다.
OnCalendar=*-*-01 23:30:00
Persistent=true

[Install]
WantedBy=timers.target
