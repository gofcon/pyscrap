[Unit]
Description=Timer for pyscrap Monthly Archive

[Timer]
# 매월 1일 04:00 -- 전날 밤 배치(22:00 export ~ 23:00 check-sql)가 끝나고
# 그날 아침 배치(08:35 daily-start)가 시작되기 전, 하루 중 가장 조용한 때.
# 내보내기와 삭제가 몇 분씩 걸릴 수 있어 다른 작업과 겹치지 않는 자리에 둔다.
#
# 요일 제한이 없다: 하는 일이 DB 안에서 끝나므로 장이 서는 날일 필요가 없다.
#
# 대상은 직전월이다(sp_archive_exported 의 기본값). 1일에 돌면 그 달은 이미
# 닫혀 있어 뒤늦게 행이 더 들어올 일이 없다.
OnCalendar=*-*-01 04:00:00
Persistent=true

[Install]
WantedBy=timers.target
