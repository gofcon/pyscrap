[Unit]
Description=pyscrap Daily Early (08:38, 장중 잡의 준비와 생성)
After=network.target

[Service]
Type=oneshot
User=opc
Group=opc
WorkingDirectory=/home/opc/pyscrap
# 예전 pyscrap-generate-3m 이 하던 일이다. 이름을 바꾼 이유: 하는 일이 3분 잡
# 생성만이 아니다 -- 만기 지난 잡을 물리고, 만기 달력과 선물옵션 마스터를
# 늘린 뒤에 생성한다. 어느 단계를 어떤 순서로는 scripts/sql/
# sp_run_daily_early.sql 이 위에서 아래로 말하고, 이 유닛은 언제만 안다.
#
# daily_start(08:35) 뒤에 있어야 한다: 그 사이클이 거래소 목록(krx_deriv_info)과
# KIS 마스터를 다시 받아 오고, 아래 단계들이 그것을 읽는다. 먼저 돌면 어제
# 목록으로 달력을 늘리고, 그날 상장된 위클리를 놓친다.
#
# Type=oneshot 의 ExecStart 들은 차례로 돌고 첫 실패에서 멈춘다 -- 마스터가
# 갱신되지 않은 채로 잡이 생성되는 것보다 그 편이 낫다.
ExecStart=/bin/bash /home/opc/pyscrap/scripts/run_command.sh call-proc sp_run_daily_early
# generate-only 로 두 샤드를 각각 한 프로세스에 -- 둘이 같은 계약 목록을 본다.
ExecStart=/bin/bash /home/opc/pyscrap/scripts/run_cycle.sh 3m_call generate-only
ExecStart=/bin/bash /home/opc/pyscrap/scripts/run_cycle.sh 3m_put generate-only

[Install]
WantedBy=multi-user.target
