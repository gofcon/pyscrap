[Unit]
Description=pyscrap 5-Minute Cycle Execution
After=network.target

[Service]
Type=oneshot
User=opc
Group=opc
WorkingDirectory=/home/opc/pyscrap
# ExecStart calls the wrapper script with cycle argument
ExecStart=/bin/bash /home/opc/pyscrap/scripts/run_cycle.sh 5m

[Install]
WantedBy=multi-user.target
