[Unit]
Description=pyscrap Monthly Archive (매월 1일 04:00, 직전월 수집분을 Parquet 으로 밀어냄)
After=network.target

[Service]
Type=oneshot
User=opc
Group=opc
WorkingDirectory=/home/opc/pyscrap
# 직전월 한 달치를 Parquet 으로 옮기고 DB 에서 지운다
# (scripts/sql/sp_archive_exported.sql). 지우기 전에 외부 테이블이 그 구간을
# 읽어내는지 확인하고, 못 읽으면 아무것도 지우지 않고 0 이 아닌 코드로 끝난다
# -- systemctl --failed 에 남는 것이 조용히 넘어가는 것보다 낫다.
#
# 대상 목록은 프로시저 안에 있다. 표를 하나 더 넣거나 빼는 것은 그 파일만
# 고치면 되고, 이 유닛은 움직이지 않는다.
ExecStart=/bin/bash /home/opc/pyscrap/scripts/run_command.sh archive-exported

[Install]
WantedBy=multi-user.target
