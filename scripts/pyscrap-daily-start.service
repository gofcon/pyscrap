[Unit]
Description=pyscrap Daily Start (08:35, 그날 수집의 시작)
After=network.target

[Service]
Type=oneshot
User=opc
Group=opc
WorkingDirectory=/home/opc/pyscrap
# 원칙: 그날 일간 자료를 받는 일이 여기서 시작한다 -- KIS 접근토큰을 받는 것이
# 그 첫 단계고, 이어서 KRX 오픈API 의 전 거래일분을 받는다. 그 전에 끝나 있어야
# 하는 사전 작업(마스터, 달력, 잡 생성)은 pyscrap-daily-early(07:00) 에 있다.
#
# 토큰은 24시간짜리고, 쓰는 쪽은 여기가 아니라 뒤다 -- 3분 스냅샷(08:42~16:45),
# 1분봉·일봉(18:00), ETF 구성종목(21:00). 그날 수집의 전제이므로 그날 수집의
# 첫 자리에 둔다.
#
# 이 유닛에만 외부 시계 제약이 있다. KRX 오픈API 는 전 거래일분을 홈페이지보다
# 늦게 내놓는다 -- 07:00 에는 다섯 개 모두 0행이었고(2026-09-22~10-01, 매일),
# 데이터가 있는 것이 확인된 가장 이른 시각은 08:35 다. 종목기본이 9월 내내 이
# 자리에서 받아 왔다. 공개 시각의 하한은 모르므로 못 받은 날은 18:00 이 한 번
# 더 묻는다 (pyscrap-daily-batch1.service, empty_is_pending).
ExecStart=/bin/bash /home/opc/pyscrap/scripts/run_cycle.sh daily_start
# 위에서 받은 종목기본을 종목당 한 행으로 접고 정제 마스터로 옮긴다. 무엇을
# 어떤 순서로는 scripts/sql/sp_run_daily_start.sql 이 말하고, 여기는 언제만 안다.
# 수집 뒤여야 한다 -- 앞에 있으면 그날 행은 다음 날 접힌다.
ExecStart=/bin/bash /home/opc/pyscrap/scripts/run_command.sh call-proc sp_run_daily_start

[Install]
WantedBy=multi-user.target
