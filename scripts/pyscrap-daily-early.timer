[Unit]
Description=Timer for pyscrap Daily Early (08:38)

[Timer]
# 08:38 -- daily_start(08:35, 45~51초) 가 끝난 뒤, 3분 첫 틱(08:42) 전. 예전
# pyscrap-generate-3m 의 자리 그대로다.
#
# 요일 제한은 app.services.job_builder._last_bday 와 같은 범위다(평일, 공휴일
# 달력 없음). 휴장일에도 돌아 빈 잡을 만드는데, 그 잡은 일주일 뒤
# sp_retire_expired_jobs 가 놓는다.
OnCalendar=Mon..Fri *-*-* 08:38:00
Persistent=true

[Install]
WantedBy=timers.target
