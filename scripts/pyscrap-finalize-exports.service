[Unit]
Description=pyscrap Finalize Exports (18:10, end of day's batch)
After=network.target

[Service]
Type=oneshot
User=opc
Group=opc
WorkingDirectory=/home/opc/pyscrap
# app.services.export.finalize_pending_exports -- CSV -> Parquet -> upload
# for whatever's still pending on disk, from any job (one-shot or repeated).
ExecStart=/bin/bash /home/opc/pyscrap/scripts/finalize_exports.sh

[Install]
WantedBy=multi-user.target
