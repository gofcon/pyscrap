[Unit]
Description=pyscrap Daily-End Execution (18:00)
After=network.target

[Service]
Type=oneshot
User=opc
Group=opc
WorkingDirectory=/home/opc/pyscrap
# ExecStart calls the wrapper script with cycle argument
ExecStart=/bin/bash /home/opc/pyscrap/scripts/run_cycle.sh daily_end

[Install]
WantedBy=multi-user.target
